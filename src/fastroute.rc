#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Version
//
// Without this the file properties show a blank version, which is no help to
// anybody trying to work out which build they are running - and with six
// releases out, that is a question people ask.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FASTROUTE_VERSION_COMMA
 PRODUCTVERSION FASTROUTE_VERSION_COMMA
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FastRoute"
            VALUE "FileVersion",     FASTROUTE_VERSION
            VALUE "InternalName",    "FastRoute"
            VALUE "LegalCopyright",  "Licensed under the GNU GPL version 3"
            VALUE "OriginalFilename","FastRoute.exe"
            VALUE "ProductName",     "FastRoute"
            VALUE "ProductVersion",  FASTROUTE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Icon

IDI_APPMAIN ICON "fastroute.ico"

/////////////////////////////////////////////////////////////////////////////
// Menu bars

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Session...\tCtrl+N",      IDM_SESSION_NEW
        MENUITEM "&Import from a File...\tCtrl+I", IDM_SESSION_IMPORT
        MENUITEM SEPARATOR
        MENUITEM "&Hide to Tray\tCtrl+H",         IDM_APP_HIDE
        MENUITEM "&Settings...\tCtrl+Comma",      IDM_APP_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                        IDM_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",                 IDM_SESSION_UNDO
        MENUITEM "&Redo\tCtrl+Y",                 IDM_SESSION_REDO
    END
    POPUP "&Session"
    BEGIN
        MENUITEM "&Open\tEnter",                 IDM_SESSION_OPEN
        MENUITEM "&Run\tCtrl+R",                 IDM_SESSION_RUN
        MENUITEM "S&top\tCtrl+R",                IDM_SESSION_STOP
        MENUITEM "Run at &Startup",              IDM_SESSION_AUTORUN
        MENUITEM "Hot&key...",                   IDM_SESSION_HOTKEY
        MENUITEM SEPARATOR
        MENUITEM "Open &Recording Folder\tCtrl+Shift+O", IDM_SESSION_OPENDIR
        MENUITEM SEPARATOR
        MENUITEM "Re&name...\tF2",               IDM_SESSION_RENAME
        MENUITEM "&Delete\tDel",                 IDM_SESSION_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Export to a File...\tCtrl+E", IDM_SESSION_EXPORT
    END
    POPUP "Sc&hedule"
    BEGIN
        MENUITEM "&New Event...\tCtrl+Shift+N", IDM_SCHED_NEW
        MENUITEM "&Edit Event...\tEnter",      IDM_SCHED_EDIT
        MENUITEM "E&nabled",                     IDM_SCHED_TOGGLE
        MENUITEM "&Delete Event\tDel",         IDM_SCHED_DELETE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Error Log...",                IDM_HELP_ERRORS
        MENUITEM "Check for &Updates...",        IDM_HELP_UPDATE
        MENUITEM "&About FastRoute",             IDM_HELP_ABOUT
    END
END

