                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 61, 190, 22
    LTEXT           "50 ms", IDC_NORM_LOOK_TEXT, 203, 67, 70, 9
    LTEXT           "&Maximum boost, the most it will ever turn up:", -1, 7, 89, 190, 9
    CONTROL         "", IDC_NORM_MAXGAIN, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 101, 190, 22
    LTEXT           "20 dB", IDC_NORM_MAXGAIN_TEXT, 203, 107, 70, 9
    LTEXT           "&Release, how fast the gain comes back up:", -1, 7, 129, 190, 9
    CONTROL         "", IDC_NORM_RELEASE, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 141, 190, 22
    LTEXT           "1000 ms", IDC_NORM_RELEASE_TEXT, 203, 147, 70, 9
    LTEXT           "The gain follows the signal so the loudest part sits on the target. Lookahead holds the audio back so the level is already down when a peak arrives. Maximum boost is what stops a quiet passage being lifted until the room tone is loud.",
                    IDC_NORM_NOTE, 7, 169, 266, 42
    CONTROL         "Block e&nabled", IDC_BLOCK_ENABLED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 219, 200, 12
    PUSHBUTTON      "&Apply",  IDC_APPLY, 109, 241, 50, 16
    DEFPUSHBUTTON   "OK",     IDOK,     166, 241, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 241, 50, 16
END

