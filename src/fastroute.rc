IDD_SCHEDULE DIALOGEX 0, 0, 320, 296
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Scheduled Event"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Session to run:", -1, 7, 7, 306, 9
    COMBOBOX        IDC_SCH_SESSION, 7, 19, 306, 200,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Start at a time of &day", IDC_SCH_MODE_TIME, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 7, 41, 306, 12
    LTEXT           "&Hour and minute:", IDC_SCH_TIMELABEL, 18, 59, 90, 9
    EDITTEXT        IDC_SCH_HOUR, 112, 57, 30, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    EDITTEXT        IDC_SCH_MIN, 148, 57, 30, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP

    CONTROL         "Start &in this many minutes from now", IDC_SCH_MODE_IN, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 7, 77, 306, 12
    LTEXT           "&Minutes from now:", IDC_SCH_INLABEL, 18, 95, 90, 9
    EDITTEXT        IDC_SCH_INMIN, 112, 93, 40, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP

    LTEXT           "&Repeat:", -1, 7, 117, 90, 9
    COMBOBOX        IDC_SCH_REPEAT, 100, 115, 160, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "On these days:", IDC_SCH_DOWLABEL, 7, 137, 306, 9
    CONTROL         "S&un", IDC_SCH_DOW+0, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 149, 40, 12
    CONTROL         "M&on", IDC_SCH_DOW+1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 54, 149, 40, 12
    CONTROL         "&Tue", IDC_SCH_DOW+2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 98, 149, 40, 12
    CONTROL         "&Wed", IDC_SCH_DOW+3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 142, 149, 44, 12
    CONTROL         "T&hu", IDC_SCH_DOW+4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 149, 40, 12
    CONTROL         "&Fri", IDC_SCH_DOW+5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 234, 149, 40, 12
    CONTROL         "Sa&t", IDC_SCH_DOW+6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 278, 149, 40, 12

    LTEXT           "St&op:", -1, 7, 173, 90, 9
    COMBOBOX        IDC_SCH_STOP, 100, 171, 160, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Hour and m&inute:", IDC_SCH_STOPLABEL, 18, 195, 90, 9
    EDITTEXT        IDC_SCH_STOPHOUR, 112, 193, 30, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    EDITTEXT        IDC_SCH_STOPMIN, 148, 193, 30, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Run for this many minu&tes:", IDC_SCH_AFTERLABEL, 18, 215, 120, 9
    EDITTEXT        IDC_SCH_AFTER, 142, 213, 40, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP

    CONTROL         "Remo&ve this event once it has run", IDC_SCH_SINGLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 237, 306, 12
    CONTROL         "Event &enabled", IDC_SCH_ENABLED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 253, 306, 12
    DEFPUSHBUTTON   "OK",     IDOK,     206, 272, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 272, 50, 16
END
