IDD_BLOCK_GATE DIALOGEX 0, 0, 280, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Noise Gate Block"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Threshold, below which the gate shuts:", -1, 7, 9, 190, 9
    CONTROL         "", IDC_GATE_THRESH, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 21, 190, 22
    LTEXT           "-40 dB", IDC_GATE_THRESH_TEXT, 203, 27, 70, 9
    LTEXT           "&Cut applied while it is shut:", -1, 7, 49, 190, 9
    CONTROL         "", IDC_GATE_RANGE, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 61, 190, 22
    LTEXT           "60 dB", IDC_GATE_RANGE_TEXT, 203, 67, 70, 9
    LTEXT           "Attac&k, how fast it opens:", -1, 7, 89, 190, 9
    CONTROL         "", IDC_GATE_ATTACK, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 101, 190, 22
    LTEXT           "5 ms", IDC_GATE_ATTACK_TEXT, 203, 107, 70, 9
    LTEXT           "&Hold, how long it stays open after the sound stops:", -1, 7, 129, 190, 9
    CONTROL         "", IDC_GATE_HOLD, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 141, 190, 22
    LTEXT           "200 ms", IDC_GATE_HOLD_TEXT, 203, 147, 70, 9
    LTEXT           "Re&lease, how fast it shuts afterwards:", -1, 7, 169, 190, 9
    CONTROL         "", IDC_GATE_RELEASE, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 181, 190, 22
    LTEXT           "150 ms", IDC_GATE_RELEASE_TEXT, 203, 187, 70, 9
    LTEXT           "L&ookahead, how early it starts opening:", -1, 7, 209, 190, 9
    CONTROL         "", IDC_GATE_LOOK, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 7, 221, 190, 22
    LTEXT           "5 ms", IDC_GATE_LOOK_TEXT, 203, 227, 70, 9
    LTEXT           "The gate opens at the threshold but does not shut until the sound has fallen 3 dB below it, so a signal sitting on the line does not switch it on and off. A cut of 0 dB turns the gate off. The lookahead delays the audio by its own length, which is how the gate can be open before the sound arrives; set it at least as long as the attack, or the attack will still be running when the sound gets there.",
                    IDC_GATE_NOTE, 7, 247, 266, 42
    CONTROL         "Block e&nabled", IDC_BLOCK_ENABLED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 293, 200, 12
    PUSHBUTTON      "&Apply",  IDC_APPLY, 109, 307, 50, 16
    DEFPUSHBUTTON   "OK",     IDOK,     166, 307, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 307, 50, 16
END

